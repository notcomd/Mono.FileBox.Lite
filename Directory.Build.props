<!-- Directory.Build.props — 全仓库共享 MSBuild 属性：集中配置 NuGet 打包元数据。 -->
<Project>

  <PropertyGroup>
    <!-- 打包版本（CI 可用 -p:PackageVersion= 覆盖） -->
    <PackageVersion Condition="'$(PackageVersion)'==''">1.0.0</PackageVersion>
    <Version Condition="'$(Version)'==''">$(PackageVersion)</Version>

    <!-- NuGet 通用元数据 -->
    <Authors>Mono.FileBox.Lite</Authors>
    <Company>Mono.FileBox.Lite</Company>
    <Product>Mono.FileBox.Lite</Product>
    <Copyright>Copyright (c) 2026 Mono.FileBox.Lite</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mono/FileBox.Lite</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mono/FileBox.Lite</PackageProjectUrl>
    <PackageTags>object-storage;content-addressable;dedup;state-machine;index;backup;cluster;filebox</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- 生成 XML 文档并把缺失注释告警 L0-L5 用 NoWarn 压掉（仓库文档注释已就绪） -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- 默认所有库可打包；示例/测试显式关闭 -->
    <IsPackable Condition="'$(IsPackable)'==''">true</IsPackable>
  </PropertyGroup>

</Project>